 
#include <stdio.h>

#define FIXED_CHARGE 5000
#define SLAB1 100
#define SLAB2 200
#define RATE1 0
#define RATE2 225
#define RATE3 450

int main()
{
    int units[] = {0, 100, 150, 200, 250};
    int i, u;
    long long bill, total;

    printf("Electricity Bill Calculation\n\n");

    for (i = 0; i < 5; i++)
    {
        u = units[i];
        bill = FIXED_CHARGE;

        if (u <= SLAB1)
            bill += u * RATE1;
        else if (u <= SLAB2)
            bill += SLAB1 * RATE1
                  + (u - SLAB1) * RATE2;
        else
            bill += SLAB1 * RATE1
                  + (SLAB2 - SLAB1) * RATE2
                  + (u - SLAB2) * RATE3;

        printf("Units: %d, Bill: Rs. %lld.%02lld\n",
               u, bill / 100, bill % 100);
    }

    /* District total example */
    total = 20750LL * 800000LL;

    printf("\nDistrict total for 800000 households: ");
    printf("Rs. %lld.%02lld\n", total / 100, total % 100);

    return 0;
}
